# Copy to backend/.env for local development.
# JWT_SECRET_KEY MUST be set to a strong random secret (32+ chars) in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Database URL. For SQLite, use absolute path for production safety.
# The app auto-resolves relative sqlite:/// paths to absolute paths relative to backend/.
# Development default: sqlite:///climatify.db (resolved to backend/climatify.db)
# Production example: sqlite:////var/lib/climatify/climatify.db
# PostgreSQL example: postgresql://user:pass@host/dbname
DATABASE_URL=sqlite:///climatify.db

ADMIN_BOOTSTRAP_EMAIL=admin@climatify.org
ADMIN_BOOTSTRAP_PASSWORD=replace-before-running-seed-admin

# CORS origins - comma-separated. Production MUST set this to the actual frontend domain(s).
# Example: https://climatify-youth.com,https://app.climatify-youth.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

RATE_LIMIT_PER_MINUTE=120

# Upload folder - absolute path recommended for production
UPLOAD_FOLDER=backend/uploads

# Frontend build directory for SPA fallback
FRONTEND_DIST=dist

AI_PROVIDER_URL=
AI_PROVIDER_KEY=

PORT=5000
