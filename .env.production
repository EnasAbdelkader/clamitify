# ==========================================================
# Climatify — Production Environment Variables
# Used by Vite during production builds (e.g. Vercel deployment)
# ==========================================================

# Default to mock API on production builds so the deployed demo app
# works out of the box without attempting to connect to local 127.0.0.1:5000
# and triggering browser Private Network Access security prompts.
VITE_USE_MOCK_API=true
