# ==========================================================
# Climatify — Environment Variables Template
# انسخ الملف ده لـ .env وعدّل القيم. الـ .env نفسه مش متتبّع في git.
#   cp .env.example .env       (PowerShell: Copy-Item .env.example .env)
#
# ⚠️ عدّل الـ .env بمحرر نصوص. متستخدمش `echo "..." > .env` —
# الـ `>` بيمسح الملف كله وبيوّدي بقية المتغيرات.
# Vite only exposes variables that start with VITE_ to the browser.
# NEVER put a secret here: everything below ships inside the JS bundle.
# ==========================================================

# 1) Base URL of the Flask REST API — MUST include the /api prefix.
#    من غير /api كل request هيرجع 404.
#    القيمة الافتراضية في الكود لو المتغير غايب: http://127.0.0.1:5000/api
#
#    Option A (direct call, needs CORS enabled on the Flask side):
VITE_API_BASE_URL=http://127.0.0.1:5000/api
#    Option B (use the Vite dev proxy in vite.config.ts — same origin, zero CORS):
# VITE_API_BASE_URL=/api

# 2) Mock mode switch. "true" هي القيمة الوحيدة اللي بتفعّله (مقارنة نصية حرفية).
#    true  = مفيش أي network request خالص؛ كل حاجة بترجع من src/services/mockData.ts.
#            استخدمه لو الباك إند لسه مش جاهز أو للعرض offline.
#    false = الفرونت بيكلّم Flask فعلاً، وأي فشل (non-2xx أو انقطاع شبكة)
#            بيظهر كرسالة خطأ واضحة في الواجهة. مفيش fallback صامت للـ mock.
#    There is NO automatic fallback to mock data on failure — this flag is the
#    ONLY way to get mock data. See docs/API_CONTRACT.md §0.
VITE_USE_MOCK_API=false

# 3) Human-readable app title.
#    ملحوظة: لسه مش مقروء في كود التطبيق (عنوان الصفحة ثابت في index.html).
#    Currently unused by the app code; reserved for future use.
VITE_APP_TITLE=Climatify - Climate Innovation Platform
